#!/usr/bin/env python3
"""Start the Unseenet node as a Home Assistant add-on.

Runs as root before the image's own entrypoint (unseenet-entrypoint):

1. reads the add-on's options from /data/options.json (written by the Supervisor);
2. hands the passphrase on in a mode-600 file on tmpfs, never in the environment
   or in the node's data;
3. writes /data/node/node.toml from the options (every start, unless
   manage_config is off and the file exists);
4. prints the node's key, so the operator can give it to peers;
5. replaces itself with the image's entrypoint, which drops root and runs the node.

The node's data lives in /data/node, not /data itself, so that the entrypoint's
chown of its data never touches the Supervisor's options.json.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

OPTIONS = Path(os.environ.get("ADDON_OPTIONS", "/data/options.json"))
DATA = Path(os.environ.get("UNSEENET_DATA", "/data/node"))
SECRET = Path(os.environ.get("ADDON_SECRET", "/tmp/addon/passphrase"))
ENTRYPOINT = os.environ.get("ADDON_ENTRYPOINT", "/usr/local/bin/unseenet-entrypoint")
UID = 10001

NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$")
KEY_RE = re.compile(r"^ed25519:[a-z2-7]{52}$")


def fail(message: str) -> None:
    print(f"[unseenet-node] {message}", file=sys.stderr, flush=True)
    sys.exit(64)


def say(message: str) -> None:
    print(f"[unseenet-node] {message}", flush=True)


def toml_str(value: str) -> str:
    """A TOML basic string. JSON's escapes are valid TOML for everything we write."""
    return json.dumps(value, ensure_ascii=False)


def toml_list(values: list[str]) -> str:
    return "[" + ", ".join(toml_str(v) for v in values) + "]"


def check_peers(peers: list[dict]) -> list[dict]:
    out, seen = [], set()
    for i, p in enumerate(peers, 1):
        name = str(p.get("name", "")).strip()
        address = str(p.get("address", "")).strip()
        key = str(p.get("key") or "").strip()
        groups = str(p.get("groups") or "").strip()
        if not NAME_RE.match(name):
            fail(f"peer #{i}: a name of letters, digits, '.', '_' or '-', not {name!r}")
        if name in seen:
            fail(f"peer #{i}: the name {name!r} is used twice")
        seen.add(name)
        if not address:
            fail(f"peer {name}: no address (the peer's onion address, e.g. abc...xyz.onion)")
        if key and not KEY_RE.match(key):
            fail(f"peer {name}: the key must look like ed25519:... (the peer's node key), "
                 f"not {key!r}")
        out.append({"name": name, "address": address, "key": key, "groups": groups})
    return out


def node_toml(o: dict) -> str:
    peers = check_peers(o.get("peers") or [])
    carries = [str(c).strip() for c in (o.get("carries") or ["*"]) if str(c).strip()] or ["*"]
    pictures = "accept" if o.get("profile_pictures") else "refuse"
    lines = [
        "# Written by the Unseenet Home Assistant add-on from its options at every start.",
        "# Change the options in Home Assistant, not this file - or turn manage_config off",
        "# to edit it by hand. See https://unseenet.org/node/configuration/",
        "[node]",
        f"name = {toml_str(str(o.get('node_name') or 'ha-unseenet'))}",
        f"min_pow = {int(o.get('min_pow', 18))}",
        f"retention_days = {int(o.get('retention_days', 90))}",
        f"new_groups = {toml_str(str(o.get('new_groups', 'accept')))}",
        f"carries = {toml_list(carries)}",
        f"announce = {'true' if o.get('announce', True) else 'false'}",
        f"auto_peers = {int(o.get('auto_peers', 3))}",
        f"avatars = {toml_str(pictures)}",
        f"emoji = {toml_str(pictures)}",
        f"sites = {toml_str('accept' if o.get('sites') else 'refuse')}",
        "",
        "# Pictures and small files (UN-RFC 0027), kept 30 days at most",
        "[blobs]",
        f"enabled = {'true' if o.get('files') else 'false'}",
        "max_size = 1048576",
        "retention_days = 30",
        f"encrypted = {'true' if o.get('encrypted_files') else 'false'}",
    ]
    for p in peers:
        lines += ["", "[[peer]]", f"name = {toml_str(p['name'])}",
                  f"address = {toml_str(p['address'])}"]
        if p["key"]:
            lines.append(f"key = {toml_str(p['key'])}")
        if p["groups"]:
            lines.append(f"groups = {toml_str(p['groups'])}")
    return "\n".join(lines) + "\n"


def main() -> None:
    try:
        o = json.loads(OPTIONS.read_text())
    except (OSError, ValueError) as exc:
        fail(f"cannot read the add-on's options ({OPTIONS}): {exc}")

    passphrase = str(o.get("passphrase") or "")
    if len(passphrase) < 12:
        fail("set a passphrase of at least 12 characters in the add-on's Configuration tab. "
             "It seals the node's keys; keep a copy somewhere safe, it cannot be recovered.")

    # /data stays root's: the node's user may pass through it to /data/node, but not
    # list it or read the options (they hold the passphrase)
    DATA.parent.chmod(0o711)
    OPTIONS.chmod(0o600)
    DATA.mkdir(parents=True, exist_ok=True)
    if DATA.stat().st_uid != UID:
        os.chown(DATA, UID, UID)
    DATA.chmod(0o700)

    # the secret: mode 600, on tmpfs; newer entrypoints hand a copy to the node's
    # user in /tmp/unseenet_node_passphrase - so not that path, or the copy empties it
    SECRET.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(SECRET, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(passphrase)
    # the node's user reads it (images before 0.7.0 do not hand a copy on themselves)
    os.chown(SECRET.parent, UID, UID)
    os.chown(SECRET, UID, UID)
    os.environ["UNSEENET_NODE_PASSPHRASE_FILE"] = str(SECRET)
    os.environ.pop("UNSEENET_NODE_PASSPHRASE", None)

    config = DATA / "node.toml"
    if o.get("manage_config", True) or not config.exists():
        text = node_toml(o)
        tmp = config.with_suffix(".toml.new")
        tmp.write_text(text)
        os.chown(tmp, UID, UID)
        tmp.chmod(0o600)
        tmp.replace(config)
        say(f"wrote {config} from the add-on's options")
    else:
        say(f"manage_config is off: using {config} as it is")

    if o.get("listen_internal"):
        # other add-ons (e.g. a council replica) may connect on the Supervisor's own
        # network; no port is published to the host or the LAN
        os.environ["UNSEENET_LISTEN"] = "0.0.0.0:1119"
        if "UNSEENET_LISTEN" in Path(ENTRYPOINT).read_text():
            say("listening on port 1119 of the add-on network too (for add-ons beside it)")
        else:
            say("listen_internal needs a node image of 0.7.0 or newer; listening on the "
                "add-on itself only")

    # the node key, for peers - the onion address follows when Tor is up
    shown = subprocess.run([ENTRYPOINT, "--show-key"], capture_output=True, text=True)
    key = next((ln.strip() for ln in reversed(shown.stdout.splitlines())
                if ln.strip().startswith("ed25519:")), None)
    if key:
        say(f"node key: {key}")
    else:
        why = (shown.stderr.strip().splitlines() or shown.stdout.strip().splitlines() or [""])[-1]
        if why:
            print(why, file=sys.stderr, flush=True)
        fail("could not unlock the node's keys - is the passphrase the one the node was "
             "first started with?")

    say("starting the node; its onion address follows once Tor is running")
    os.execv(ENTRYPOINT, [ENTRYPOINT])


if __name__ == "__main__":
    main()
